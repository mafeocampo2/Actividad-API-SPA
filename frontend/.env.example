# Copia este archivo como .env para elegir a qué API se conecta la app.

# API desplegada en Render (funciona desde cualquier red):
EXPO_PUBLIC_API_URL=https://mi-app-api-63nf.onrender.com/api/v1

# O el backend de tu PC (celular y PC en la misma red WiFi; IP con ipconfig -> Dirección IPv4):
# EXPO_PUBLIC_API_URL=http://192.168.1.10:3000/api/v1
